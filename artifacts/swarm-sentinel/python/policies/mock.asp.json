{
  "asp-version": "1.0",
  "description": "Policy for the synthetic normal/attack scenarios. Mock tools only.",
  "network": {
    "default": "deny",
    "allow": []
  },
  "tools": {
    "default": "deny",
    "allow": ["mock:search.read", "mock:mcp:wiki.write", "mock:mcp:board.write"],
    "deny": [],
    "deny-arguments": []
  },
  "content-trust": {
    "system-prompt": "high",
    "user-input": "medium",
    "tool-response": "low",
    "retrieved-document": "untrusted",
    "contaminated-write": "report"
  },
  "delegation": {
    "sub-agents": "inherit-and-restrict",
    "max-depth": 4
  },
  "reporting": {
    "violations": "local:flight-recorder"
  },
  "swarm": {
    "window-seconds": 10,
    "repeated-intent": { "limit": 5, "min-agents": 3, "actions": ["tool"] },
    "write-cap": 6,
    "tripwires": {
      "fanout-children": 4,
      "shared-state-agents": 4,
      "consensus-min-cluster": 3,
      "consensus-density": 0.5,
      "echo-agents": 0,
      "echo-similarity": 0.6
    }
  }
}

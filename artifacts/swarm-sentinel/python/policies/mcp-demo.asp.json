{
  "asp-version": "1.0",
  "description": "MCP proxy mode demo: agents reach a disposable notes fixture server only through the engine-hosted MCP endpoint. Offline fixtures, no real network or filesystem outside the session workspace.",
  "network": {"default": "deny", "allow": ["docs.example.org"]},
  "tools": {
    "default": "deny",
    "allow": ["mcp:notes:read", "mcp:notes:write", "mcp:web:fetch"],
    "deny": [],
    "deny-arguments": [
      {"tool": "mcp:notes:write", "pattern": "BEGIN [A-Z ]*PRIVATE KEY", "label": "private key material in a note"}
    ]
  },
  "content-trust": {
    "system-prompt": "high",
    "user-input": "medium",
    "tool-response": "low",
    "retrieved-document": "untrusted",
    "contaminated-write": "deny",
    "contaminated-deny": [],
    "propagate-via-messages": true
  },
  "delegation": {"sub-agents": "inherit-and-restrict", "max-depth": 4},
  "reporting": {"violations": "local:flight-recorder"},
  "swarm": {
    "window-seconds": 30,
    "repeated-intent": {"limit": 5, "min-agents": 3, "actions": ["tool"]},
    "write-cap": 6,
    "step-budget": 20,
    "tripwires": {
      "fanout-children": 4,
      "shared-state-agents": 4,
      "consensus-min-cluster": 3,
      "consensus-density": 0.5,
      "echo-agents": 0,
      "echo-similarity": 0.6,
      "taint-agents": 3,
      "delegation-loop": true
    }
  },
  "inspection": {
    "tools": ["mcp:*"],
    "arguments": {"secrets": "deny", "pii": "report", "injection": "report"},
    "results": {"secrets": "redact", "pii": "report", "injection": "taint"}
  },
  "mcp": {
    "servers": {
      "notes": {
        "command": "{python}",
        "args": ["{fixtures}/notes_server.py", "--root", "{workspace}"],
        "tools": {
          "read_note": {"target": "mcp:notes:read", "write": false},
          "write_note": {"target": "mcp:notes:write", "write": true, "resource": "mcp:notes"},
          "fetch_page": {"target": "mcp:web:fetch", "write": false, "reads": "untrusted", "network-argument": "url"}
        }
      }
    }
  }
}
